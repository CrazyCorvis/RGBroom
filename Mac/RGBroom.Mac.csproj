<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RGBroom.Engine</AssemblyName>
    <RootNamespace>MagicHomeNET</RootNamespace>
    <Version>9.1.0</Version>
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);.build/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Source/Models.cs;../Source/Effects.cs;../Source/LightEngine.cs;../Source/Network.cs;../Source/WifiConnections.cs;../Source/ExtraWifiDiscovery.cs;../Source/TuyaConnection.cs;../Source/SelfTests.cs;../Source/AdapterTests.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Source/Models.json" LogicalName="MagicHomeNET.Models.json" />
    <None Include="native/libRGBroomNative.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="libRGBroomNative.dylib" Condition="Exists('native/libRGBroomNative.dylib')" />
  </ItemGroup>
  <Target Name="IncludeRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <RuntimeNotice Include="@(ResolvedRuntimePack->'%(PackageDirectory)/LICENSE.TXT')" />
      <RuntimeNotice Include="@(ResolvedRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeNotice)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
